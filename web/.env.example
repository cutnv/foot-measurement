POSTGRES_DB=foot_measurement
POSTGRES_USER=foot_admin
POSTGRES_PASSWORD=replace-with-a-long-random-password
APP_DB_PASSWORD=replace-with-a-different-long-random-password
READER_DB_PASSWORD=replace-with-another-long-random-password
SAVE_TOKEN_SECRET=replace-with-at-least-32-random-characters
ADMIN_SESSION_SECRET=replace-with-another-32-random-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
SESSION_COOKIE_SECURE=false
POSTGRES_PORT=5432
POSTGRES_LOG_STATEMENT=none

# Production can omit the local db service and provide an encoded cloud URL:
# DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=verify-full
# ADMIN_DATABASE_URL=postgresql://read_only_user:password@host:5432/database?sslmode=verify-full
